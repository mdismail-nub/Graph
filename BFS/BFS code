#include <bits/stdc++.h>
using namespace std;

vector<int> bfs(vector<vector<int>> &adj, int n) {
vector<int> vis(n + 1, 0);
vector<int> bfs;
queue<int> q;

vis[1] = 1;  
q.push(1);  

while (!q.empty()) {  
    int node = q.front();  
    q.pop();  

    bfs.push_back(node);  

    for (auto it : adj[node]) {  
        if (!vis[it]) {  
            vis[it] = 1;  
            q.push(it);  
        }  
    }  
}  

return bfs;

}

int main() {
int n, m;
cin >> n >> m;

vector<vector<int>> adj(n + 1);  

for (int i = 0; i < m; i++) {  
    int u, v;  
    cin >> u >> v;  

    adj[u].push_back(v);  
    adj[v].push_back(u);  
}  

vector<int> ans = bfs(adj, n);  

for (int x : ans)  
    cout << x << " ";  

return 0;

}

